---
import AmbientAudio from '../components/AmbientAudio.astro';
import BaseHead from '../components/BaseHead.astro';
import IceBackground from '../components/IceBackground.astro';
import Nav from '../components/Nav.astro';
import SoundEffects from '../components/SoundEffects.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`設定 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<AmbientAudio />
		<SoundEffects />
		<div id="world">
			<IceBackground />
			<div class="scrim"></div>

			<Nav />

			<main>
				<div class="page-header">
					<div class="eyebrow">如履薄冰 · SETTINGS</div>
					<h1 class="page-title">設定</h1>
				</div>

				<div class="settings-list">
					<div class="setting-row">
						<div class="setting-copy">
							<div class="setting-label">環境音</div>
							<div class="setting-desc">背景音樂與雪地環境音，在整個網站持續播放，不會因為換頁而中斷。</div>
						</div>
						<button
							type="button"
							id="music-toggle"
							class="toggle"
							role="switch"
							aria-checked="true"
							aria-label="環境音開關"
						>
							<span class="toggle-track"><span class="toggle-thumb"></span></span>
						</button>
					</div>
					<div class="setting-row">
						<div class="setting-copy">
							<div class="setting-label">音效</div>
							<div class="setting-desc">切換分頁、點進文章時的提示音效，跟環境音分開控制。</div>
						</div>
						<button
							type="button"
							id="sfx-toggle"
							class="toggle"
							role="switch"
							aria-checked="true"
							aria-label="音效開關"
						>
							<span class="toggle-track"><span class="toggle-thumb"></span></span>
						</button>
					</div>
				</div>
			</main>
		</div>

		<script>
			// Wires a toggle button to a pair of window-exposed get/set
			// functions (one pair per audio subsystem — Ambient Soundtrack's
			// __mmIsMusicEnabled/__mmSetMusicEnabled, SoundEffects' own
			// __mmIsSfxEnabled/__mmSetSfxEnabled) — same shape, independent
			// state, so this one function drives both toggles below.
			function wireToggle(buttonId: string, isEnabledKey: string, setEnabledKey: string) {
				const button = document.getElementById(buttonId);
				if (!button) return;

				const isEnabled = (window as any)[isEnabledKey] as (() => boolean) | undefined;
				const setEnabled = (window as any)[setEnabledKey] as ((enabled: boolean) => void) | undefined;
				if (!isEnabled || !setEnabled) return;

				function render() {
					const enabled = isEnabled!();
					button!.setAttribute('aria-checked', String(enabled));
					button!.classList.toggle('is-on', enabled);
				}
				render();

				button.addEventListener('click', () => {
					setEnabled!(!isEnabled!());
					render();
				});
			}

			function init() {
				wireToggle('music-toggle', '__mmIsMusicEnabled', '__mmSetMusicEnabled');
				wireToggle('sfx-toggle', '__mmIsSfxEnabled', '__mmSetSfxEnabled');
			}

			document.addEventListener('astro:page-load', init);
		</script>
	</body>
</html>

<style>
	#world {
		background: #04070d;
		color: #f2fbff;
		overflow: hidden;
	}

	.scrim {
		position: fixed;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgba(4, 7, 13, 15%) 0%,
			rgba(4, 7, 13, 55%) 38%,
			rgba(4, 7, 13, 86%) 62%,
			rgba(4, 7, 13, 96%) 100%
		);
		pointer-events: none;
	}

	main {
		position: relative;
		z-index: 3;
		width: auto;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	.page-header {
		padding: 6vh clamp(1.2rem, 5vw, 4rem) 1rem;
		max-width: 1100px;
		margin: 0 auto;
	}
	.eyebrow {
		font-size: 0.76rem;
		letter-spacing: 0.15em;
		color: var(--accent);
		margin-bottom: 0.8rem;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-shadow: 0 2px 20px rgba(4, 7, 13, 90%);
	}
	.eyebrow::before {
		content: '';
		width: 22px;
		height: 1px;
		background: var(--accent);
	}
	.page-title {
		font-family: var(--font-noto-serif-tc);
		font-weight: 700;
		font-size: clamp(1.8rem, 4.2vw, 2.8rem);
		color: #f2fbff;
		text-shadow: 0 2px 30px rgba(4, 7, 13, 90%);
	}

	.settings-list {
		max-width: 640px;
		margin: 3rem auto 8rem;
		padding: 0 clamp(1.2rem, 5vw, 4rem);
	}

	.setting-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.4rem 1.6rem;
		background: rgba(var(--black), 7%);
		border: 1px solid rgba(var(--black), 16%);
		backdrop-filter: blur(14px);
		clip-path: polygon(0 6%, 96% 0, 100% 92%, 4% 100%);
	}
	.setting-label {
		font-family: var(--font-noto-serif-tc);
		font-weight: 600;
		font-size: 1.05rem;
	}
	.setting-desc {
		margin-top: 0.4rem;
		font-size: 0.84rem;
		color: #a9c4d4;
		line-height: 1.6;
	}

	.toggle {
		flex-shrink: 0;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}
	.toggle-track {
		display: block;
		width: 44px;
		height: 26px;
		border-radius: 999px;
		background: rgba(242, 251, 255, 18%);
		border: 1px solid rgba(242, 251, 255, 24%);
		position: relative;
		transition: background 0.25s ease;
	}
	.toggle-thumb {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #f2fbff;
		transition: transform 0.25s ease;
	}
	.toggle.is-on .toggle-track {
		background: var(--accent);
		border-color: var(--accent);
	}
	.toggle.is-on .toggle-thumb {
		transform: translateX(18px);
		background: #04070d;
	}
</style>
