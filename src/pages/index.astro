---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline>
			// Entrance-once-per-session gate: reads sessionStorage (which CSS can't
			// touch) and, if the entrance already played this session, marks <html>
			// with data-skip-entrance before first paint so the CSS entrance
			// keyframe never starts (no flash-then-cut). This is the narrow
			// input-reading exception documented in CONTEXT.md — the animation
			// itself stays entirely in CSS.
			try {
				if (sessionStorage.getItem('ice-entrance-played')) {
					document.documentElement.dataset.skipEntrance = 'true';
				} else {
					sessionStorage.setItem('ice-entrance-played', 'true');
				}
			} catch {
				// Storage unavailable (private mode, etc.) — entrance just plays
				// every time. Acceptable degradation, not a correctness bug.
			}
		</script>
	</head>
	<body data-zone="immersive">
		<Header />
		<main class="ice-hero">
			<div class="ice-scene" aria-hidden="true">
				<svg
					class="glacier glacier--far"
					viewBox="0 0 800 220"
					preserveAspectRatio="none"
				>
					<polygon
						points="0,220 0,140 90,95 180,130 260,70 360,115 460,60 560,110 660,75 760,120 800,90 800,220"
						fill="currentColor"
					></polygon>
				</svg>
				<svg
					class="glacier glacier--mid"
					viewBox="0 0 800 220"
					preserveAspectRatio="none"
				>
					<polygon
						points="0,220 0,170 120,110 240,150 340,90 480,145 600,100 720,150 800,120 800,220"
						fill="currentColor"
					></polygon>
				</svg>
				<svg
					class="glacier glacier--near"
					viewBox="0 0 800 220"
					preserveAspectRatio="none"
				>
					<polygon
						points="0,220 0,200 100,150 220,190 320,140 460,195 580,150 700,195 800,170 800,220"
						fill="currentColor"
					></polygon>
				</svg>

				<div class="aurora"></div>

				<div class="snowfall">
					<div class="snow-layer snow-layer--1"></div>
					<div class="snow-layer snow-layer--2"></div>
					<div class="snow-layer snow-layer--3"></div>
				</div>

				<svg class="icicle icicle--left" viewBox="0 0 70 150">
					<path
						d="M0 0 L70 0 L54 70 L40 46 L30 104 L16 64 L8 128 L0 70 Z"
						fill="currentColor"
					></path>
				</svg>
				<svg class="icicle icicle--right" viewBox="0 0 70 150">
					<path
						d="M0 0 L70 0 L62 68 L48 44 L38 120 L24 60 L12 100 L0 60 Z"
						fill="currentColor"
					></path>
				</svg>

				<svg class="crack-field" viewBox="0 0 800 500" preserveAspectRatio="none">
					<path
						class="crack crack--a"
						d="M40 460 L220 380 L300 410 L420 300 L520 340 L680 220 L760 250"
						fill="none"
						stroke="currentColor"
						stroke-width="3"
					></path>
					<path
						class="crack crack--b"
						d="M300 410 L340 470 M420 300 L400 240 M520 340 L560 400"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					></path>
				</svg>

				<div class="cold-light"></div>
			</div>

			<div class="hero-content">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
				<a class="cta" href="/blog">走到對岸</a>
				<a class="cta" href="/donate">給他20元打車</a>
			</div>
		</main>
		<Footer />

		<script>
			const hero = document.querySelector('.ice-hero');
			if (hero instanceof HTMLElement && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
				hero.addEventListener('mousemove', (event) => {
					const rect = hero.getBoundingClientRect();
					const x = ((event.clientX - rect.left) / rect.width) * 100;
					const y = ((event.clientY - rect.top) / rect.height) * 100;
					hero.style.setProperty('--cursor-x', `${x}%`);
					hero.style.setProperty('--cursor-y', `${y}%`);
					hero.dataset.cursorActive = 'true';
				});
				hero.addEventListener('mouseleave', () => {
					hero.dataset.cursorActive = 'false';
				});
			}
		</script>
	</body>
</html>

<style>
	.ice-hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 100%;
		min-height: min(88vh, 760px);
		margin: 0;
		padding: 3em 1em;
		overflow: hidden;
		background:
			radial-gradient(ellipse 65% 45% at 50% 15%, rgba(var(--gray-light), 65%), transparent 70%),
			linear-gradient(180deg, rgb(var(--surface)) 0%, rgb(var(--bg)) 100%);
		isolation: isolate;
		filter: blur(0) brightness(1) saturate(1);
	}

	/* Entrance moment: plays once per homepage entry this session (gated by the
	   inline script above) and only when the visitor hasn't asked to reduce
	   motion. Default (no animation) state is the settled hero, so this fails
	   safe if JS is unavailable. */
	@media (prefers-reduced-motion: no-preference) {
		:root:not([data-skip-entrance]) .ice-hero {
			animation: entrance-clear 1.3s cubic-bezier(0.16, 1, 0.3, 1) both;
		}
	}
	@keyframes entrance-clear {
		0% {
			filter: blur(22px) brightness(2.2) saturate(0.3);
		}
		100% {
			filter: blur(0) brightness(1) saturate(1);
		}
	}

	.ice-scene {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.glacier {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 55%;
	}
	.glacier--far {
		height: 40%;
		color: rgba(150, 190, 230, 30%);
	}
	.glacier--mid {
		height: 48%;
		color: rgba(120, 165, 210, 45%);
	}
	.glacier--near {
		height: 58%;
		color: rgba(var(--surface), 90%);
	}

	.aurora {
		position: absolute;
		top: -8%;
		left: -20%;
		width: 140%;
		height: 50%;
		background: linear-gradient(
			100deg,
			transparent 0%,
			rgba(84, 227, 180, 50%) 22%,
			rgba(120, 200, 255, 48%) 46%,
			rgba(180, 120, 255, 42%) 68%,
			transparent 86%
		);
		filter: blur(20px);
		mix-blend-mode: screen;
		opacity: 0.85;
	}
	@media (prefers-reduced-motion: no-preference) {
		.aurora {
			animation: aurora-drift 16s ease-in-out infinite;
		}
	}
	@keyframes aurora-drift {
		0%,
		100% {
			transform: translateX(-4%) scaleY(1);
		}
		50% {
			transform: translateX(4%) scaleY(1.08);
		}
	}

	.snowfall {
		position: absolute;
		inset: -10%;
	}
	.snow-layer {
		position: absolute;
		inset: 0;
		background-repeat: repeat;
	}
	.snow-layer--1 {
		background-image: radial-gradient(circle, rgba(255, 255, 255, 95%) 1px, transparent 1.6px);
		background-size: 42px 60px;
		opacity: 0.9;
	}
	.snow-layer--2 {
		background-image: radial-gradient(circle, rgba(255, 255, 255, 80%) 1.6px, transparent 2.4px);
		background-size: 90px 130px;
		opacity: 0.7;
	}
	.snow-layer--3 {
		background-image: radial-gradient(circle, rgba(255, 255, 255, 65%) 2.4px, transparent 3.4px);
		background-size: 150px 210px;
		opacity: 0.5;
	}
	@media (prefers-reduced-motion: no-preference) {
		.snow-layer--1 {
			animation: snow-drift-1 6s linear infinite;
		}
		.snow-layer--2 {
			animation: snow-drift-2 10s linear infinite;
		}
		.snow-layer--3 {
			animation: snow-drift-3 16s linear infinite;
		}
	}
	@keyframes snow-drift-1 {
		from {
			background-position: 0 0;
		}
		to {
			background-position: -60px 600px;
		}
	}
	@keyframes snow-drift-2 {
		from {
			background-position: 0 0;
		}
		to {
			background-position: 90px 900px;
		}
	}
	@keyframes snow-drift-3 {
		from {
			background-position: 0 0;
		}
		to {
			background-position: -140px 1200px;
		}
	}

	.icicle {
		position: absolute;
		top: 0;
		width: clamp(3em, 7vw, 5em);
		height: auto;
		color: rgba(220, 240, 255, 75%);
		filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 40%));
	}
	.icicle--left {
		left: 6%;
	}
	.icicle--right {
		right: 8%;
	}

	.crack-field {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		color: rgba(200, 230, 255, 55%);
		-webkit-mask-image: radial-gradient(
			circle 240px at var(--cursor-x, 50%) var(--cursor-y, 55%),
			black 0%,
			black 35%,
			transparent 78%
		);
		mask-image: radial-gradient(
			circle 240px at var(--cursor-x, 50%) var(--cursor-y, 55%),
			black 0%,
			black 35%,
			transparent 78%
		);
		opacity: 0.55;
		transition: opacity 0.3s ease;
	}
	[data-cursor-active='true'] .crack-field {
		opacity: 1;
		color: rgba(230, 245, 255, 85%);
	}

	.cold-light {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle 260px at var(--cursor-x, 50%) var(--cursor-y, 55%),
			rgba(180, 230, 255, 35%),
			transparent 70%
		);
		opacity: 0;
		transition: opacity 0.25s ease;
	}
	[data-cursor-active='true'] .cold-light {
		opacity: 1;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 34em;
		text-align: center;
	}
	.hero-content h1 {
		font-size: 3.4em;
		color: rgb(var(--black));
		text-shadow: 0 0 24px rgba(127, 224, 255, 35%);
	}
	.hero-content p {
		color: rgb(var(--gray-dark));
		font-size: 1.1em;
	}
	.cta {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.6em 1.6em;
		border: 1px solid var(--accent);
		border-radius: 999px;
		color: var(--accent);
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}
	.cta:hover {
		background: var(--accent);
		color: rgb(var(--bg));
	}

	/* Mobile: hold the Lighthouse Performance >= 90 floor by trimming the
	   most expensive layers (blur, the densest snow layer) rather than
	   shrinking everything proportionally. */
	@media (max-width: 640px) {
		.snow-layer--3 {
			display: none;
		}
		.glacier--far {
			display: none;
		}
		.aurora {
			filter: blur(12px);
		}
	}
</style>
