---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import AmbientAudio from '../components/AmbientAudio.astro';
import DirectionalTransition from '../components/DirectionalTransition.astro';
import Nav from '../components/Nav.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Reused as the "最新一篇" entry point from /demo/hero_to_article_flow.html,
// sourced from the real content collection instead of the prototype's
// hardcoded placeholder.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPost = posts[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<DirectionalTransition />
		<AmbientAudio />
		<div id="world">
			<!--
			  The canvas sits fixed behind the whole page — including the nav — so
			  there's no separate flat-background band behind Nav.astro; the nav
			  floats directly over the 3D scene, same as every other page's
			  IceBackground.astro. This markup IS the fallback (dark background,
			  real headline, a real link) by construction — the WebGL setup script
			  below only ever *adds* a canvas into #canvas-wrap when WebGL is
			  available and prefers-reduced-motion isn't set.
			-->
			<div class="canvas-wrap" id="canvas-wrap" aria-hidden="true"></div>

			<Nav />

			<!-- Home's own room in the Continuous World (see CONTEXT.md). -->
			<main class="ice-hero" id="ice-hero">
				<div class="overlay">
					<div class="bottom-bar">
						<div class="headline">
							<div class="eyebrow">哎呦，這不薄冰哥嗎 · ON THIN ICE</div>
							<h1>{SITE_TITLE}</h1>
							<p class="sub">{SITE_DESCRIPTION}</p>
							<p class="drag-hint">拖曳不可轉動視角</p>
						</div>

						<div class="hero-actions">
							{
								latestPost && (
									<a
										class="floe"
										id="enter-article"
										href={`/blog/${latestPost.id}/`}
										data-nav-direction="right"
									>
										<div class="label">最新一篇</div>
										<div class="title">{latestPost.data.title}</div>
										<div class="hint">點擊走到對岸 →</div>
									</a>
								)
							}
							<button class="regen-btn" id="regen" type="button" hidden>重新生成地形 ↻</button>
						</div>
					</div>
				</div>
			</main>
		</div>

		<script>
			// Astro's client router only ever evaluates a *bundled* module script's
			// top-level code once per session (the browser's own module cache dedupes
			// it across "visits" to the same page) — data-astro-rerun exists to force
			// re-execution, but it does that by re-injecting the script as literal
			// inline text on every real navigation, which can't contain `import`
			// statements. So the actual Three.js logic lives here, in a normal
			// bundled module (defined once), and the tiny data-astro-rerun script
			// below just calls the entry point it exposes — that's what re-runs on
			// every real return to the homepage.
			import * as THREE from 'three';
			import {
				ICE_WORLD_SEED,
				createEnvMap,
				createSkyMesh,
				createSnowField,
				createTerrain,
				disposeObject3D,
				supportsWebGL,
				updateSkyMesh,
				updateSnowField,
			} from '../scripts/iceWorld';

			function initIceScene() {
				const hero = document.getElementById('ice-hero');
				const canvasWrap = document.getElementById('canvas-wrap');
				const regenButton = document.getElementById('regen') as HTMLButtonElement | null;
				if (!hero || !canvasWrap || !regenButton) {
					throw new Error('ice-hero markup missing expected elements');
				}

				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!supportsWebGL() || prefersReducedMotion) return;

				initScene();

				function initScene() {
					// Desktop reuses ice_terrain_3d.html's fuller values; mobile reuses
					// hero_to_article_flow.html's lighter ones — the same 640px breakpoint
					// convention used by every page's mobile simplification.
					const isMobile = window.innerWidth < 640;
					const SEGMENTS = isMobile ? 90 : 130;
					const SNOW_COUNT = isMobile ? 900 : 2200;
					const SIZE = 46;

					// ---------- renderer / scene / camera ----------
					const renderer = new THREE.WebGLRenderer({ antialias: true });
					renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
					renderer.setSize(canvasWrap!.clientWidth, canvasWrap!.clientHeight);
					renderer.outputColorSpace = THREE.SRGBColorSpace;
					renderer.toneMapping = THREE.ACESFilmicToneMapping;
					renderer.toneMappingExposure = 1.15;
					canvasWrap!.appendChild(renderer.domElement);

					const scene = new THREE.Scene();
					scene.fog = new THREE.FogExp2(0x0a1522, 0.032);

					const camera = new THREE.PerspectiveCamera(
						45,
						canvasWrap!.clientWidth / canvasWrap!.clientHeight,
						0.1,
						200,
					);

					function onResize() {
						camera.aspect = canvasWrap!.clientWidth / canvasWrap!.clientHeight;
						camera.updateProjectionMatrix();
						renderer.setSize(canvasWrap!.clientWidth, canvasWrap!.clientHeight);
					}
					window.addEventListener('resize', onResize);

					const skyMesh = createSkyMesh();
					scene.add(skyMesh);

					const envMap = createEnvMap(renderer);
					scene.environment = envMap;

					// ---------- lights ----------
					const dirLight = new THREE.DirectionalLight(0xdbeeff, 1.6);
					dirLight.position.set(8, 14, 6);
					scene.add(dirLight);
					scene.add(new THREE.AmbientLight(0x233d52, 0.55));
					const rim = new THREE.PointLight(0x3ee6c4, 1.4, 40);
					rim.position.set(-10, 4, -8);
					scene.add(rim);
					const rim2 = new THREE.PointLight(0x8a7cf0, 1.0, 40);
					rim2.position.set(10, 3, -10);
					scene.add(rim2);

					// ---------- procedural ice terrain (regenerable for the homepage's
					// interactive "regen" button; every other page uses ICE_WORLD_SEED
					// as-is, unregenerated, for visual consistency) ----------
					let terrainMesh: THREE.Mesh | null = null;
					function buildTerrain(seed: number) {
						if (terrainMesh) {
							scene.remove(terrainMesh);
							disposeObject3D(terrainMesh);
						}
						terrainMesh = createTerrain({ seed, size: SIZE, segments: SEGMENTS, envMap });
						scene.add(terrainMesh);
					}
					buildTerrain(ICE_WORLD_SEED);

					// ---------- snow ----------
					const snow = createSnowField({ count: SNOW_COUNT, size: SIZE, fallHeight: 22 });
					scene.add(snow.points);

					// ---------- interaction: drag to orbit ----------
					let isDragging = false;
					let lastX = 0;
					let lastY = 0;
					let theta = 0.5;
					let phi = 1.15;
					let radius = 15;

					function updateCamera() {
						camera.position.x = radius * Math.sin(phi) * Math.sin(theta);
						camera.position.z = radius * Math.sin(phi) * Math.cos(theta);
						camera.position.y = radius * Math.cos(phi) + 3;
						camera.lookAt(0, 1, 0);
					}
					updateCamera();

					renderer.domElement.style.touchAction = 'none';

					function onPointerDown(e: PointerEvent) {
						isDragging = true;
						lastX = e.clientX;
						lastY = e.clientY;
					}
					function onPointerUp() {
						isDragging = false;
					}
					function onPointerMove(e: PointerEvent) {
						if (!isDragging) return;
						const dx = e.clientX - lastX;
						const dy = e.clientY - lastY;
						lastX = e.clientX;
						lastY = e.clientY;
						theta -= dx * 0.005;
						phi = THREE.MathUtils.clamp(phi - dy * 0.005, 0.4, 1.5);
						updateCamera();
					}
					function onWheel(e: WheelEvent) {
						radius = THREE.MathUtils.clamp(radius + e.deltaY * 0.01, 8, 28);
						updateCamera();
					}
					renderer.domElement.addEventListener('pointerdown', onPointerDown);
					window.addEventListener('pointerup', onPointerUp);
					window.addEventListener('pointermove', onPointerMove);
					renderer.domElement.addEventListener('wheel', onWheel, { passive: true });

					// ---------- regenerate button ----------
					function onRegenClick() {
						buildTerrain(Math.random() * 1000);
					}
					regenButton!.addEventListener('click', onRegenClick);
					regenButton!.hidden = false;

					// ---------- render loop ----------
					const clock = new THREE.Clock();
					let rafId = 0;
					function animate() {
						rafId = requestAnimationFrame(animate);
						const dt = clock.getDelta();
						const elapsed = clock.getElapsedTime();

						updateSkyMesh(skyMesh, elapsed);
						updateSnowField(snow, dt, elapsed);

						if (!isDragging) {
							theta += dt * 0.02;
							updateCamera();
						}

						rim.position.x = Math.sin(elapsed * 0.2) * 10;
						rim2.position.x = Math.cos(elapsed * 0.17) * 10;

						renderer.render(scene, camera);
					}
					animate();

					// ---------- resource disposal on real navigation away from home ----------
					function disposeScene() {
						cancelAnimationFrame(rafId);
						window.removeEventListener('resize', onResize);
						window.removeEventListener('pointerup', onPointerUp);
						window.removeEventListener('pointermove', onPointerMove);
						renderer.domElement.removeEventListener('pointerdown', onPointerDown);
						renderer.domElement.removeEventListener('wheel', onWheel);
						regenButton!.removeEventListener('click', onRegenClick);

						disposeObject3D(scene);
						envMap.dispose();
						renderer.dispose();
						renderer.domElement.remove();

						document.removeEventListener('astro:before-swap', disposeScene);
						if ((window as any).__iceSceneCleanup === disposeScene) {
							delete (window as any).__iceSceneCleanup;
						}
					}

					// initIceScene() re-runs on every real return to the homepage (see the
					// trigger script below) — replace any stale listener from a previous
					// mount rather than stacking a new one on top of it.
					if ((window as any).__iceSceneCleanup) {
						document.removeEventListener('astro:before-swap', (window as any).__iceSceneCleanup);
					}
					(window as any).__iceSceneCleanup = disposeScene;
					document.addEventListener('astro:before-swap', disposeScene);
				}
			}

			(window as any).__initIceScene = initIceScene;

			// Module scripts are deferred (they run after the document is parsed),
			// but the data-astro-rerun classic script below runs immediately in
			// document order — on the very first load it would fire before
			// __initIceScene exists. Call it directly here for that first-ever
			// execution; the trigger below handles every subsequent real return to
			// this page, once the module (and this window property) already exist.
			initIceScene();
		</script>

		<!--
		  This is the piece that actually needs data-astro-rerun: Astro re-injects
		  it as literal inline text on every real navigation to this page (unlike
		  the bundled module above, which the browser's module cache only
		  evaluates once), so it's the trigger that makes the scene reinitialize
		  each time a visitor returns home.
		-->
		<script data-astro-rerun>
			if (typeof window.__initIceScene === 'function') {
				window.__initIceScene();
			}
		</script>
	</body>
</html>

<style>
	/* This is the fallback background for when WebGL/prefers-reduced-motion
	   rules out the canvas — it must live on #world, not .ice-hero, now that
	   canvas-wrap is a fixed sibling painted before .ice-hero in DOM order.
	   .ice-hero staying transparent is what lets the canvas show through the
	   full page height (including behind Nav) when the scene does render;
	   putting an opaque background back on .ice-hero would paint over the
	   canvas everywhere .ice-hero's box extends, hiding the animation again. */
	#world {
		background: linear-gradient(180deg, rgb(var(--surface)) 0%, rgb(var(--bg)) 100%);
	}

	.canvas-wrap {
		position: fixed;
		inset: 0;
		z-index: 0;
	}
	.canvas-wrap :global(canvas) {
		display: block;
	}

	.ice-hero {
		position: relative;
		width: 100%;
		max-width: none;
		min-height: calc(100vh - 5.5rem);
		margin: 0;
		padding: 0;
		overflow: hidden;
		color: rgb(var(--black));
	}

	.overlay {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: calc(100vh - 5.5rem);
		padding: 0 clamp(1.2rem, 4vw, 3.5rem) 2rem;
	}

	.bottom-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: flex-end;
	}

	.headline {
		max-width: 640px;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.76rem;
		letter-spacing: 0.15em;
		color: var(--accent);
		margin-bottom: 1rem;
	}
	.eyebrow::before {
		content: '';
		width: 22px;
		height: 1px;
		background: var(--accent);
	}
	.headline h1 {
		font-weight: 700;
		font-size: clamp(1.7rem, 4.4vw, 3rem);
		line-height: 1.4;
		text-shadow: 0 2px 30px rgba(4, 7, 13, 80%);
	}
	.headline .sub {
		margin-top: 0.9rem;
		color: rgb(var(--gray-dark));
		font-weight: 300;
		font-size: 0.95rem;
		max-width: 30em;
		line-height: 1.7;
		text-shadow: 0 2px 20px rgba(4, 7, 13, 80%);
	}
	.headline .drag-hint {
		margin-top: 0.5rem;
		font-size: 0.78rem;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 1rem;
	}

	.floe {
		cursor: pointer;
		max-width: 380px;
		padding: 1.4rem 1.6rem;
		background: rgba(var(--black), 7%);
		border: 1px solid rgba(var(--black), 16%);
		backdrop-filter: blur(14px);
		clip-path: polygon(0 8%, 92% 0, 100% 86%, 12% 100%, 0 60%);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.4s ease,
			box-shadow 0.4s ease;
	}
	.floe:hover {
		transform: translateY(-4px) rotate(-0.3deg);
		box-shadow: 0 12px 40px rgba(62, 230, 196, 15%);
	}
	.floe .label {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		margin-bottom: 0.5rem;
	}
	.floe .title {
		font-family: var(--font-noto-serif-tc);
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgb(var(--black));
	}
	.floe .hint {
		margin-top: 0.7rem;
		font-size: 0.74rem;
		color: rgb(var(--gray));
	}

	.regen-btn {
		font-family: var(--font-atkinson);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		color: rgb(var(--bg));
		background: rgb(var(--black));
		border: none;
		padding: 0.75rem 1.4rem;
		cursor: pointer;
		clip-path: polygon(6% 0, 100% 0, 100% 78%, 94% 100%, 0 100%, 0 22%);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
		box-shadow: 0 6px 24px rgba(62, 230, 196, 18%);
	}
	.regen-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 32px rgba(62, 230, 196, 30%);
	}

	@media (max-width: 640px) {
		.bottom-bar {
			flex-direction: column;
			align-items: stretch;
		}
		.hero-actions {
			align-items: stretch;
		}
		.floe {
			max-width: none;
		}
	}
</style>
