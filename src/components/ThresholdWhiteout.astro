---
// The Threshold Transition's whiteout overlay. Rendered on every top-level
// page/layout, right after <body>, with transition:persist so it survives a
// real Astro navigation as one continuous element rather than two
// independently-timed ones (see CONTEXT.md's Threshold Transition entry).
//
// The homepage's own script (index.astro) fades this to full opacity and
// calls navigate() once it's fully covering the screen. This component only
// owns fading it back OUT after arrival — that has to work regardless of
// which page it lands on, so it can't live in the homepage's Three.js script.
---

<div id="threshold-whiteout" class="threshold-whiteout" transition:persist transition:name="threshold-whiteout" aria-hidden="true">
</div>

<style>
	.threshold-whiteout {
		position: fixed;
		inset: 0;
		z-index: 999;
		background: radial-gradient(circle at 50% 55%, #ffffff 0%, #eaf6fb 55%, #cfe9f5 100%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.6s ease;
	}
</style>

<script>
	function settleWhiteout() {
		const whiteout = document.getElementById('threshold-whiteout');
		if (whiteout && whiteout.style.opacity === '1') {
			// Let the just-arrived page paint one frame before fading, so the
			// fade-out is visible rather than instant.
			requestAnimationFrame(() => {
				whiteout.style.opacity = '0';
			});
		}
	}

	document.addEventListener('astro:page-load', settleWhiteout);
</script>
