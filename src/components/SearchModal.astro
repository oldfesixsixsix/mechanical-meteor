---
// Pagefind-backed search (see docs/adr/0004's "search... removed, not
// redesigned" follow-up). Rendered in Nav.astro next to the settings icon,
// same bare-icon treatment — no button background, hover fades to --accent.
// Pagefind's index (/pagefind/pagefind-ui.js + .css) is only generated by
// `astro build && pagefind --site dist`; it doesn't exist in `astro dev`, so
// this only works after a production build — run `npm run build`, then
// serve dist/ locally to test.
---

<button id="search-toggle" type="button" class="mm-nav-icon" aria-label="搜尋文章">
	<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
		<circle cx="11" cy="11" r="7"></circle>
		<path d="m21 21-4.3-4.3"></path>
	</svg>
</button>

<div id="search-modal" class="search-modal" hidden>
	<div id="search-modal-backdrop" class="search-modal-backdrop"></div>
	<div class="search-modal-panel" role="dialog" aria-modal="true" aria-label="搜尋文章">
		<div id="pagefind-search"></div>
	</div>
</div>

<style>
	.mm-nav-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		color: rgb(var(--gray-dark));
		opacity: 0.85;
		cursor: pointer;
		filter: drop-shadow(0 2px 10px rgba(4, 7, 13, 80%));
		transition: opacity 0.3s;
	}
	.mm-nav-icon:hover {
		opacity: 1;
		color: var(--accent);
	}

	.search-modal {
		display: none;
	}
	.search-modal:not([hidden]) {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 10vh 1em 1em;
	}
	.search-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(4, 7, 13, 75%);
	}
	.search-modal-panel {
		position: relative;
		width: 100%;
		max-width: 640px;
		max-height: 70vh;
		overflow: auto;
		padding: 1.2em;
		border-radius: 12px;
		/* Same glass treatment as Floe Card / the homepage's floe card — a
		   near-transparent tint over the Continuous World background, not a
		   solid panel — kept readable by the darker backdrop above. */
		background: rgba(var(--black), 7%);
		border: 1px solid rgba(var(--black), 16%);
		backdrop-filter: blur(14px);
		box-shadow: var(--box-shadow);
	}

	:global(.pagefind-ui) {
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-text: rgb(var(--gray-dark));
		--pagefind-ui-background: transparent;
		--pagefind-ui-border: rgba(var(--black), 16%);
		--pagefind-ui-tag: rgba(var(--black), 16%);
		--pagefind-ui-font: var(--font-atkinson);
	}
</style>

<script>
	const toggle = document.getElementById('search-toggle');
	const modal = document.getElementById('search-modal');
	const backdrop = document.getElementById('search-modal-backdrop');
	let initialized = false;

	function loadScript(src: string) {
		return new Promise<void>((resolve, reject) => {
			const script = document.createElement('script');
			script.src = src;
			script.onload = () => resolve();
			script.onerror = () => reject(new Error(`Failed to load ${src}`));
			document.head.appendChild(script);
		});
	}

	function loadStyle(href: string) {
		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = href;
		document.head.appendChild(link);
	}

	async function openModal() {
		if (!modal) return;
		modal.hidden = false;
		document.body.style.overflow = 'hidden';
		if (!initialized) {
			initialized = true;
			loadStyle('/pagefind/pagefind-ui.css');
			await loadScript('/pagefind/pagefind-ui.js');
			// @ts-ignore - PagefindUI is loaded globally by the script above
			new PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
		}
		modal.querySelector('input')?.focus();
	}

	function closeModal() {
		if (!modal) return;
		modal.hidden = true;
		document.body.style.overflow = '';
		toggle?.focus();
	}

	toggle?.addEventListener('click', openModal);
	backdrop?.addEventListener('click', closeModal);
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
		if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
			event.preventDefault();
			openModal();
		}
	});
</script>
