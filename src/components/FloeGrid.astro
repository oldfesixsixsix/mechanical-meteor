---
// The Floe Card grid (see CONTEXT.md) shared by the blog index and
// tag-filtered list pages: pure-text cards (category tag, title, excerpt,
// date — no hero image, no reading-time figure), with the irregular
// clip-path edge ruled structural, not decoration.
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="grid">
	{
		posts.map((post) => (
			<li>
				<a class="floe-card" href={`/blog/${post.id}/`} data-nav-direction="right">
					{post.data.tags && post.data.tags.length > 0 && <div class="tag">{post.data.tags[0]}</div>}
					<div class="title">{post.data.title}</div>
					<div class="excerpt">{post.data.description}</div>
					<div class="meta">
						<FormattedDate date={post.data.pubDate} />
					</div>
				</a>
			</li>
		))
	}
</ul>

<style>
	.grid {
		position: relative;
		z-index: 3;
		max-width: 1100px;
		margin: 3rem auto 8rem;
		padding: 0 clamp(1.2rem, 5vw, 4rem);
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 2.2rem 1.8rem;
		list-style: none;
	}

	.floe-card {
		display: block;
		position: relative;
		padding: 1.5rem 1.7rem 1.7rem;
		background: rgba(6, 10, 16, 50%);
		border: 1px solid rgba(242, 251, 255, 14%);
		backdrop-filter: blur(14px);
		text-decoration: none;
		color: inherit;
		cursor: pointer;
		/* Structural styling, not decoration (see CONTEXT.md's Decoration vs.
		   Structural Styling ruling) — a fractured card edge, static only. */
		clip-path: polygon(0 6%, 93% 0, 100% 88%, 10% 100%, 0 62%);
		transition:
			transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 0.45s ease,
			border-color 0.4s ease;
	}
	li:nth-child(6n + 2) .floe-card {
		clip-path: polygon(4% 0, 100% 4%, 96% 100%, 0 94%);
	}
	li:nth-child(6n + 3) .floe-card {
		clip-path: polygon(0 10%, 90% 0, 100% 82%, 14% 100%, 0 55%);
	}
	li:nth-child(6n + 4) .floe-card {
		clip-path: polygon(6% 0, 100% 8%, 94% 100%, 0 90%);
	}
	li:nth-child(6n + 5) .floe-card {
		clip-path: polygon(0 4%, 96% 0, 100% 92%, 8% 100%, 0 68%);
	}
	li:nth-child(6n + 6) .floe-card {
		clip-path: polygon(3% 0, 100% 6%, 97% 100%, 0 96%);
	}
	.floe-card:hover {
		transform: translateY(-6px);
		border-color: rgba(62, 230, 196, 40%);
		box-shadow: 0 16px 44px rgba(62, 230, 196, 16%);
	}
	.floe-card .tag {
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: var(--accent);
		margin-bottom: 0.7rem;
	}
	.floe-card .title {
		font-family: var(--font-noto-serif-tc);
		font-weight: 600;
		font-size: 1.1rem;
		line-height: 1.6;
		color: #f2fbff;
	}
	.floe-card .excerpt {
		margin-top: 0.7rem;
		font-size: 0.86rem;
		color: #a9c4d4;
		line-height: 1.7;
	}
	.floe-card .meta {
		margin-top: 1.1rem;
		font-size: 0.74rem;
		color: #6c8ea1;
	}
</style>
