---
// Reused from /demo/hero_to_article_flow.html's .crack-divider — a static,
// structural divider (see CONTEXT.md's Decoration vs. Structural Styling
// ruling: this replaces a plain <hr>, it doesn't animate).
---

<div class="crack-divider" role="separator" aria-hidden="true">
	<svg viewBox="0 0 700 14" preserveAspectRatio="none">
		<path d="M0 7 L120 4 L180 10 L260 3 L340 9 L420 5 L520 11 L600 4 L700 8"></path>
	</svg>
</div>

<style>
	.crack-divider {
		margin: 1.75em 0;
		height: 14px;
	}
	.crack-divider svg {
		width: 100%;
		height: 100%;
		opacity: 0.5;
	}
	.crack-divider path {
		stroke: rgba(var(--black), 35%);
		stroke-width: 1;
		fill: none;
	}
</style>
